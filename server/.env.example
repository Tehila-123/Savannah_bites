# Google OAuth credentials for the Savannah Bites mobile app
# Create these at https://console.cloud.google.com/apis/credentials
# 1. OAuth consent screen -> External -> add your own Google account as a Test user
# 2. Credentials -> Create Credentials -> OAuth client ID -> Web application
# 3. Authorized redirect URI: http://localhost:3000/auth/google/callback
#    Plus one per LAN IP you test from, e.g.
#    http://192.168.1.20:3000/auth/google/callback
#    Google compares the redirect_uri exactly, so the host the phone sends must be registered.
#
# Then copy this file to ".env" and fill in your real values.

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Optional. Pin the redirect_uri instead of deriving it from the request host.
# Set this when testing from a phone so the value always matches what Google has registered.
# GOOGLE_REDIRECT_URI=http://192.168.1.20:3000/auth/google/callback

# Optional. Where the backend sends the user after Google approves them, so the app
# can pick the session back up. Must match "scheme" in ../app.json (savannahbites).
# APP_DEEP_LINK=savannahbites://auth

# Optional. Key used to sign the hand-off that returns the user to the app.
# Falls back to GOOGLE_CLIENT_SECRET, then to a random per-boot key.
# SESSION_SECRET=change-me-to-a-long-random-string

# Optional. Port the API listens on. Must match PORT in ../src/services/googleAuth.js
# PORT=3000